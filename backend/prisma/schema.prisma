generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
  BOTH
  ADMIN
}

enum EventStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  CANCELLED
}

enum TicketStatus {
  RESERVED
  PAID
  CANCELLED
  CHECKED_IN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  role         Role     @default(PARTICIPANT)
  avatarUrl    String?  @map("avatar_url")
  bio          String?
  refreshToken String?  @map("refresh_token")
  createdAt    DateTime @default(now()) @map("created_at")

  eventsOrganized Event[]        @relation("OrganizerEvents")
  tickets         Ticket[]
  comments        Comment[]
  following       Follow[]       @relation("FollowerRelation")
  followers       Follow[]       @relation("OrganizerRelation")
  notifications   Notification[]

  @@map("users")
}

model Event {
  id             String      @id @default(uuid())
  organizerId    String      @map("organizer_id")
  organizer      User        @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  title          String
  description    String
  date           DateTime
  location       String
  lat            Float?
  lng            Float?
  category       String
  price          Decimal     @default(0) @db.Decimal(10, 2)
  maxAttendees   Int?        @map("max_attendees")
  imageUrl       String?     @map("image_url")
  status         EventStatus @default(DRAFT)
  createdAt      DateTime    @default(now()) @map("created_at")

  tickets  Ticket[]
  comments Comment[]

  @@map("events")
}

model Ticket {
  id           String       @id @default(uuid())
  eventId      String       @map("event_id")
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String       @map("user_id")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       TicketStatus @default(RESERVED)
  qrCode       String       @unique @map("qr_code")
  purchasedAt  DateTime     @default(now()) @map("purchased_at")

  @@unique([eventId, userId])
  @@map("tickets")
}

model Comment {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  rating    Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  follower    User     @relation("FollowerRelation", fields: [followerId], references: [id], onDelete: Cascade)
  organizerId String   @map("organizer_id")
  organizer   User     @relation("OrganizerRelation", fields: [organizerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([followerId, organizerId])
  @@map("follows")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}
